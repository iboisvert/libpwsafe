# Silence warnings for POSIX/C-runtime names (strdup, fopen, ...)
set(CMAKE_C_FLAGS_INIT "/W3 /D_CRT_SECURE_NO_WARNINGS /D_CRT_NONSTDC_NO_WARNINGS")
set(CMAKE_CXX_FLAGS_INIT "/W3 /D_CRT_SECURE_NO_WARNINGS /D_CRT_NONSTDC_NO_WARNINGS")
set(CMAKE_C_FLAGS_DEBUG_INIT "/Od /Zi")
set(CMAKE_CXX_FLAGS_DEBUG_INIT "/Od /Zi")
